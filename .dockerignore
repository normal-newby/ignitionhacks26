.git
.gitignore
.idea
.vscode

# Host-built artifacts — these must be rebuilt inside the image.
# frontend/node holds a Windows node.exe locally, which would break the Linux build.
backend/target
backend/src/main/resources/static
frontend/node_modules
frontend/node
frontend/dist

# Local secrets — Render supplies these as real env vars.
backend/.env
backend/.env.gpg

# Source GLBs for the built-in catalog. Uploaded once through /catalog and then served from
# MinIO, so they have no business inside the image — they're ~90MB between them.
seed-assets
